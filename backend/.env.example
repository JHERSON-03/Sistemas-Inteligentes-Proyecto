# Clave secreta para firmar los tokens JWT (cámbiala en producción)
SECRET_KEY=cambia-esta-clave-secreta-de-al-menos-32-caracteres
# Base de datos (SQLite por defecto)
DATABASE_URL=sqlite:///./pasteur.db
# Origen del frontend permitido por CORS
FRONTEND_ORIGIN=http://localhost:5173

# ---- Tutor IA ----
# Proveedor: groq (gratis, https://console.groq.com/keys) o xai (Grok, https://console.x.ai)
LLM_PROVIDER=groq
# Pega aquí tu API key. Sin clave el tutor usa el motor socrático local (reglas).
LLM_API_KEY=
# Opcional: cambiar el modelo (por defecto groq: openai/gpt-oss-120b, xai: grok-3-mini)
LLM_MODEL=
